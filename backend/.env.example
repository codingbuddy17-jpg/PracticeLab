# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/chartviewer

# S3-compatible storage (Cloudflare R2 on Render, Azure Blob later)
STORAGE_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=your_access_key
STORAGE_SECRET_KEY=your_secret_key
STORAGE_BUCKET_NAME=chartviewer-files
STORAGE_PUBLIC_URL=https://your-public-bucket-url

# Master admin passphrase (for retiring other trainers' charts)
MASTER_ADMIN_PASSPHRASE=changeme2024

# App
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
